# stalld app (Expo) environment variables.

# --- App ---
# Display name (e.g. shown as the Stripe Payment Sheet merchant name).
EXPO_PUBLIC_APP_NAME=stalld

# --- Supabase (auth + database) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Stripe (client SDK) ---
# Publishable key only. Use a pk_test_ key for dev, pk_live_ for prod.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- AWS backend ---
# Base URL of the stalld AWS HTTP API (the `ApiBaseUrl` output from the
# stalld-Api-<env> CDK stack). No trailing slash.
EXPO_PUBLIC_API_BASE_URL=
