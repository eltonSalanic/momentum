# Deploy-time config for the stalld AWS CDK app.
# These are NOT secrets (the Supabase URL is the same public value the app uses).
# Real secrets (Stripe keys, Supabase service-role key) live in Secrets Manager
# and are set AFTER deploy with `aws secretsmanager put-secret-value` (see README).

# Supabase project URL for the environment you are deploying (dev project for dev).
SUPABASE_URL=https://your-dev-project-ref.supabase.co

# Optional: pin which AWS account/region CDK deploys to (otherwise uses your default profile).
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=us-east-1
