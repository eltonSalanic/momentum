{
  "name": "stalld-aws",
  "version": "1.0.0",
  "private": true,
  "description": "AWS (CDK) backend compute for stalld: Stripe API, webhooks, and the missed-commitment billing pipeline.",
  "bin": {
    "stalld-aws": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:dev": "cdk deploy --all -c env=dev",
    "destroy:dev": "cdk destroy --all -c env=dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.3.0",
    "jose": "^5.9.6",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.699.0",
    "@aws-sdk/client-sqs": "^3.699.0",
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  }
}
